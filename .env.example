# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.
#
# Cách đưa câu trả lời qua LLM:
#   1. cp .env.example .env
#   2. Chọn LLM_PROVIDER=openai (hoặc gemini / anthropic)
#   3. Dán key vào OPENAI_API_KEY / GEMINI_API_KEY / ANTHROPIC_API_KEY
#   4. (Tuỳ chọn) LLM_MODEL=gpt-4o-mini
#   5. streamlit run app.py
# Restart app sau khi sửa .env. Không commit file .env.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: openai | gemini | sentence_transformers
# Phải cùng provider khi index và khi query. Đổi model thì xóa chroma_db/ rồi chạy lại task4.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=
